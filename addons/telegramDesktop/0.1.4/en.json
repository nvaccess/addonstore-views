{"addonId": "telegramDesktop", "displayName": "Telegram Desktop Accessibility", "URL": "https://github.com/keyang556/tdesktopnvda/releases/download/0.1.4/telegramDesktop-0.1.4.nvda-addon", "description": "Improves Telegram Desktop accessibility for NVDA users.\n\nAdds Alt+1 to move focus to the chat list, Alt+M to open Telegram's main menu, and Alt+Y, Alt+N, Alt+A and Alt+V to answer a call, hang up, mute the microphone and turn the camera on or off. The add-on uses Telegram's stable UIA class information and leaves Telegram's native accessible names unchanged.", "sha256": "17767ab51040fa4457fff0b119c307d4bce536075f76227f98b83a41bb8f7fff", "addonVersionName": "0.1.4", "addonVersionNumber": {"major": 0, "minor": 1, "patch": 4}, "minNVDAVersion": {"major": 2024, "minor": 1, "patch": 0}, "lastTestedVersion": {"major": 2026, "minor": 3, "patch": 0}, "channel": "beta", "publisher": "Ken Chang", "sourceURL": "https://github.com/keyang556/tdesktopnvda", "license": "GPL v2", "changelog": "Added call commands that match UnigramPlus: Alt+Y answers an incoming call, Alt+N declines it or ends the call in progress, Alt+A mutes or unmutes the microphone, and Alt+V turns the camera on or off. Each command reports the action in Telegram's own wording. Updated all translations and manuals for version 0.1.4.", "licenseURL": "https://www.gnu.org/licenses/gpl-2.0.html", "submissionTime": 1788148033000, "vtScanUrl": "https://www.virustotal.com/gui/file/17767ab51040fa4457fff0b119c307d4bce536075f76227f98b83a41bb8f7fff", "scanResults": {"virusTotal": [{"_id": "17767ab51040fa4457fff0b119c307d4bce536075f76227f98b83a41bb8f7fff", "_type": "file", "filecondis": {"dhash": "00101c1c1d080000", "raw_md5": "8b45fd7807304825865da94c9b4d3eb1"}, "first_submission_date": 1788148037, "last_analysis_results": {}, "last_analysis_stats": {"confirmed-timeout": 0, "failure": 0, "harmless": 0, "malicious": 0, "suspicious": 0, "timeout": 0, "type-unsupported": 0, "undetected": 0}, "last_modification_date": 1788