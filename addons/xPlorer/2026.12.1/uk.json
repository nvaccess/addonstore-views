0438\u0439 \u0432\u0438\u0433\u043b\u044f\u0434\n\u041f\u043e\u0442\u0440\u0456\u0439\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f: \u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u043c\u0430\u0441\u043e\u0432\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0432\u0430\u043d\u043d\u044f\n\nNVDA+Shift+Z\n\u041e\u0434\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f: \u041e\u0437\u0432\u0443\u0447\u0438\u0442\u0438 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440 \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u043d\u044f\n\u041f\u043e\u0434\u0432\u0456\u0439\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f: \u0421\u0442\u0438\u0441\u043d\u0443\u0442\u0438 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0435 \u0443 zip-\u0430\u0440\u0445\u0456\u0432\n\u041f\u043e\u0442\u0440\u0456\u0439\u043d\u0435 \u043d\u0430\u0442\u0438\u0441\u043a\u0430\u043d\u043d\u044f: \u0420\u043e\u0437\u043f\u0430\u043a\u0443\u0432\u0430\u0442\u0438 \u0432\u0438\u0431\u0440\u0430\u043d\u0438\u0439 \u0430\u0440\u0445\u0456\u0432\n\nNVDA+Shift+R\n\u041e\u0434\u0438\u043d\u0430\u0440\u043d\u0438\u0439 \u0442\u0430\u043f: Robocopy  \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0435 \u0434\u043b\u044f \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f\n\u041f\u043e\u0434\u0432\u0456\u0439\u043d\u0438\u0439 \u0442\u0430\u043f: Robocopy  \u0432\u0441\u0442\u0430\u0432\u0438\u0442\u0438 \u0432 \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u043f\u0430\u043f\u043a\u0443\n\u041f\u043e\u0442\u0440\u0456\u0439\u043d\u0438\u0439 \u0442\u0430\u043f: Robocopy  \u043f\u043e\u0437\u043d\u0430\u0447\u0438\u0442\u0438 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u0435 \u0434\u043b\u044f \u043f\u0435\u0440\